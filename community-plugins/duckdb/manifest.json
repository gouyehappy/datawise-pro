{
  "manifestVersion": 1,
  "id": "io.datawise.community.duckdb",
  "name": "DuckDB Files",
  "version": "0.1.0",
  "publisher": "datawise-community",
  "icon": "assets/plugin.svg",
  "description": "Ad-hoc SQL over a local DuckDB database or a folder of Parquet / CSV files — no warehouse load required.",
  "license": "Apache-2.0",
  "tags": ["duckdb", "parquet", "csv", "local-analytics"],
  "permissions": ["host.workbench", "host.events", "host.clipboard"],
  "engines": {
    "datawise": ">=4.1.0",
    "hostApi": "^1.3"
  },
  "entrypoints": {
    "backend": {
      "executable": "bin/duckdb-plugin.jar",
      "transport": "stdio-jsonl"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.datawise.community.duckdb.connection",
      "label": "DuckDB / files",
      "icon": "assets/plugin.svg",
      "capabilities": ["test", "connect"],
      "fields": [
        {
          "key": "databasePath",
          "label": "Database file",
          "type": "text",
          "binding": "config",
          "default": ":memory:",
          "placeholder": ":memory: or C:\\data\\analytics.duckdb"
        },
        {
          "key": "dataDir",
          "label": "Data directory (Parquet / CSV)",
          "type": "text",
          "binding": "config",
          "placeholder": "C:\\data\\lake"
        },
        {
          "key": "readOnly",
          "label": "Read only",
          "type": "boolean",
          "binding": "config",
          "default": true
        }
      ],
      "workbench": "io.datawise.community.duckdb.workbench"
    },
    {
      "type": "workbench",
      "id": "io.datawise.community.duckdb.workbench",
      "label": "DuckDB workbench"
    },
    {
      "type": "context-menu",
      "id": "io.datawise.community.duckdb.open",
      "label": "Open DuckDB workbench",
      "menu": "connection"
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "DuckDB 文件库",
      "description": "对本机 DuckDB 库或 Parquet / CSV 目录做即席 SQL，无需先灌进数仓。",
      "contributions": {
        "io.datawise.community.duckdb.connection": {
          "label": "DuckDB / 文件",
          "fields": {
            "databasePath": { "label": "数据库文件" },
            "dataDir": { "label": "数据目录（Parquet / CSV）" },
            "readOnly": { "label": "只读" }
          }
        },
        "io.datawise.community.duckdb.workbench": { "label": "DuckDB 工作台" },
        "io.datawise.community.duckdb.open": { "label": "打开 DuckDB 工作台" }
      }
    }
  }
}
