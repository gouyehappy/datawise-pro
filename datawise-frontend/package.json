{
  "name": "@datawise/frontend",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "DataWise CLI - database desktop client",
  "overrides": {
    "vue": "$vue",
    "lucide-vue-next": "$lucide-vue-next",
    "monaco-editor": "$monaco-editor"
  },
  "homepage": "https://github.com/gouyehappy/datawise-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gouyehappy/datawise-cli.git"
  },
  "scripts": {
    "//desktop": "Shipping shell is JCEF only (dev:desktop / dist:desktop). Windows Setup.exe is Inno Setup.",
    "dev": "node scripts/ensure-sql-editor-deps.mjs && vite",
    "dev:standard": "node scripts/ensure-sql-editor-deps.mjs && cross-env VITE_DATAWISE_EDITION=standard vite",
    "dev:desktop": "npm run dev:jcef",
    "dev:jcef": "node ../datawise-desktop/scripts/ensure-and-run.mjs",
    "dev:jcef:dual": "node ../datawise-desktop/scripts/ensure-and-run.mjs --dual",
    "dev:all": "node scripts/ensure-sql-editor-deps.mjs && node ../scripts/dev-start.mjs",
    "dev:all:standard": "node scripts/ensure-sql-editor-deps.mjs && cross-env VITE_DATAWISE_EDITION=standard node ../scripts/dev-start.mjs",
    "dev:all:dual": "node scripts/ensure-sql-editor-deps.mjs && node ../scripts/dev-start.mjs --dual",
    "stop:dev": "node ../scripts/dev-stop.mjs",
    "build": "node scripts/ensure-sql-editor-deps.mjs && vue-tsc --noEmit && vite build",
    "build:standard": "node scripts/ensure-sql-editor-deps.mjs && cross-env VITE_DATAWISE_EDITION=standard vue-tsc --noEmit && cross-env VITE_DATAWISE_EDITION=standard vite build",
    "build:desktop": "node scripts/ensure-sql-editor-deps.mjs && cross-env DATAWISE_DESKTOP=true vue-tsc --noEmit && cross-env DATAWISE_DESKTOP=true vite build",
    "ensure:sql-editor": "node scripts/ensure-sql-editor-deps.mjs",
    "dist:desktop": "node ../datawise-desktop/scripts/build-desktop.mjs",
    "dist:desktop:slim": "node ../datawise-desktop/scripts/build-desktop.mjs --profile slim",
    "dist:desktop:full": "node ../datawise-desktop/scripts/build-desktop.mjs --profile full",
    "dist:desktop:publish": "node ../datawise-desktop/scripts/build-desktop.mjs --publish",
    "publish:connectors": "node scripts/desktop/publish-connectors.mjs",
    "mock:connector-market": "node scripts/desktop/mock-connector-market.mjs",
    "mock:connector-market:seed": "node scripts/desktop/mock-connector-market.mjs --no-serve --seed-user",
    "mock:connector-market:build": "node scripts/desktop/mock-connector-market.mjs --build --no-serve --seed-user",
    "dist:desktop:mac": "node ../datawise-desktop/scripts/require-os.mjs darwin && node ../datawise-desktop/scripts/build-desktop.mjs",
    "dist:desktop:linux": "node ../datawise-desktop/scripts/require-os.mjs linux && node ../datawise-desktop/scripts/build-desktop.mjs",
    "dist:jcef": "npm run dist:desktop",
    "publish:desktop:release": "node scripts/desktop/publish-github-release.mjs",
    "pack:desktop": "node ../datawise-desktop/scripts/build-desktop.mjs --dir",
    "prepare:desktop": "node scripts/desktop/bundle-backend.mjs",
    "size-report:desktop": "node scripts/desktop/size-report.mjs",
    "release-smoke:desktop": "node scripts/desktop/release-smoke.mjs",
    "generate:runtime-catalog": "node scripts/desktop/generate-runtime-catalog.mjs",
    "build:backend": "node scripts/desktop/maven.mjs",
    "stop:desktop": "node scripts/desktop/lib.mjs --stop-processes",
    "clean:desktop": "node scripts/desktop/clean.mjs --all",
    "clear:desktop": "npm run clean:desktop",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:all": "npm run typecheck --prefix ../sql-editor && vue-tsc --noEmit",
    "gen:openapi-types": "npx --yes openapi-typescript ../docs/openapi/openapi.json -o src/shared/api/generated/openapi.d.ts",
    "test": "node scripts/run-unit-tests.mjs",
    "test:bugs": "tsx --import ./scripts/test-setup.mjs --test src/__tests__/regression/**/*.test.ts",
    "test:analysis-stream": "tsx --import ./scripts/test-setup.mjs --test src/__tests__/regression/analysis-stream*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:analysis": "playwright test e2e/analysis-stream.spec.ts",
    "test:e2e:backend": "playwright test -c playwright.backend.config.ts",
    "gen:sql-snippets": "npm run gen:snippets --prefix ../sql-editor",
    "audit:plugin-catalog": "tsx --import ./scripts/test-setup.mjs scripts/audit-plugin-catalog.ts",
    "audit:plugin-catalog:strict": "tsx --import ./scripts/test-setup.mjs scripts/audit-plugin-catalog.ts --strict",
    "audit:feature-permissions": "tsx --import ./scripts/test-setup.mjs scripts/audit-feature-permissions.ts",
    "audit:layer-imports": "node scripts/audit-layer-imports.mjs",
    "audit:api-facade-imports": "node scripts/audit-api-facade-imports.mjs",
    "audit:feature-deep-imports": "node scripts/audit-feature-deep-imports.mjs",
    "gen:icons": "node scripts/generate-app-icons.mjs",
    "capture:demos": "tsx scripts/capture-demo-screenshots.ts",
    "capture:ui-audit": "tsx scripts/capture-ui-audit-screenshots.ts",
    "capture:website": "tsx scripts/capture-website-screenshots.ts",
    "scan:dual-skin": "tsx scripts/scan-dual-skin.ts",
    "audit:ui-style": "node scripts/audit-ui-style.mjs",
    "check:ui-audit": "node scripts/check-ui-audit-matrix.mjs",
    "test:components": "vitest run",
    "test:components:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@datawise/chrome": "file:../packages/chrome",
    "@datawise/code": "file:../packages/code",
    "@datawise/data-grid": "file:../packages/data-grid",
    "@datawise/framework": "file:../packages/framework",
    "@datawise/graph-canvas": "file:../packages/graph-canvas",
    "@datawise/icons": "file:../packages/icons",
    "@datawise/overlays": "file:../packages/overlays",
    "@datawise/shortcuts": "file:../packages/shortcuts",
    "@datawise/sql-editor": "file:../sql-editor",
    "@datawise/theme": "file:../packages/theme",
    "@datawise/tokens": "file:../packages/tokens",
    "@datawise/ui": "file:../packages/ui",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^12.8.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.2.6",
    "dt-sql-parser": "^4.5.0",
    "echarts": "^5.6.0",
    "exceljs": "^4.4.0",
    "lucide-vue-next": "^0.577.0",
    "monaco-editor": "^0.55.1",
    "monaco-vim": "^0.4.4",
    "pinia": "^3.0.1",
    "reka-ui": "^2.10.1",
    "simple-icons": "^16.24.1",
    "sql-formatter": "^15.8.1",
    "vue": "^3.5.45",
    "vue-i18n": "^9.14.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.52.0",
    "@types/dompurify": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "happy-dom": "^20.11.2",
    "sharp": "^0.35.2",
    "svg-path-bbox": "^2.1.0",
    "to-ico": "^1.1.5",
    "tsx": "^4.19.4",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.6"
  }
}
