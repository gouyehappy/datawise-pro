  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./*": "./src/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@datawise/chrome": "5.0.0",
    "@datawise/icons": "5.0.0",
    "@datawise/overlays": "5.0.0",
    "@datawise/theme": "5.0.0",
