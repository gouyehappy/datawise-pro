    "exceljs": "^4.4.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@datawise/chrome": {
      "optional": true
    },
    "@datawise/icons": {
      "optional": true
    },
    "@datawise/overlays": {
      "optional": true
    },
    "@datawise/theme": {
      "optional": true
    },
    "@datawise/ui": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@datawise/chrome": "file:../chrome",
    "@datawise/icons": "file:../icons",
    "@datawise/overlays": "file:../overlays",
    "@datawise/theme": "file:../theme",
    "@datawise/ui": "file:../ui",
    "typescript": "~5.7.2",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  }
}
