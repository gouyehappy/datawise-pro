    <build>
        <pluginManagement>
            <plugins>
                <!--
                  spring-boot-maven-plugin
                  作用：把可运行模块打成可执行 fat-jar（含依赖、Main-Class）。
                  本父工程默认 skip，避免聚合模块误打包；真正启用在 datawise-server。
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>

                <!--
                  maven-compiler-plugin
                  作用：编译 Java 源码。parameters=true 保留方法参数名，
                  供 Spring MVC @RequestParam / 反射使用。
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>UTF-8</encoding>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <!--
                  maven-resources-plugin
                  作用：复制 resources（yml/xml 等），统一 UTF-8，避免 Windows 下配置乱码。
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <configuration>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>

                <!--
                  maven-surefire-plugin
                  作用：跑单元测试（*Test.java）。argLine 修复部分新 JDK 上 JUnit 发现失败。

                  @{argLine} 必须保留：jacoco prepare-agent 把 -javaagent 写进 argLine 属性，
                  这里若用字面量覆盖，agent 不会被加载，jacoco.exec 永远为空，
                  覆盖率门禁会在“无数据”状态下静默跳过。
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>@{argLine} -Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
                        <systemPropertyVariables>
                            <jdk.net.URLClassPath.disableClassPathURLCheck>true</jdk.net.URLClassPath.disableClassPathURLCheck>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>

                <!--
                  maven-failsafe-plugin
                  作用：跑集成测试（*IT.java / *ITCase.java），在 verify 阶段执行。

                  failsafe 不像 surefire 那样自带默认 execution，必须显式绑定
                  integration-test + verify 两个 goal，否则 `mvn verify` 不会执行任何 IT。
                  用 `mvn verify` 或 `mvn verify -DskipITs=false` 触发；
                  `mvn test` 不会进入这些阶段，因此日常单测循环不受影响。
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <configuration>
                        <argLine>@{argLine} -Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
                        <includes>
                            <include>**/*IT.java</include>
                            <include>**/*ITCase.java</include>
                        </includes>
                    </configuration>
                    <executions>
                        <execution>
                            <id>integration-tests</id>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!--
                  maven-shade-plugin
                  作用：打 uber-jar / 重定位包名，connector 插件常用。
                  这里只给默认配置（剥签名、合并 META-INF/services）；具体 include 由子模块覆盖。
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>${maven-shade-plugin.version}</version>
                    <configuration>
                        <createDependencyReducedPom>false</createDependencyReducedPom>
                        <filters>
                            <filter>
                                <artifact>*:*</artifact>
                                <excludes>
                                    <exclude>META-INF/*.SF</exclude>
                                    <exclude>META-INF/*.DSA</exclude>
                                    <exclude>META-INF/*.RSA</exclude>
                                </excludes>
                            </filter>
                        </filters>
                        <transformers>
                            <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                        </transformers>
                    </configuration>
                </plugin>

                <!--
                  maven-dependency-plugin
                  作用：分析/拷贝依赖。常用：dependency:tree、dependency:copy-dependencies。
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>

                <!--
                  maven-antrun-plugin
                  作用：在构建阶段跑 Ant 任务。connectors 用它把插件 jar 拷到 config/plugins。
                  版本在此统一；具体 execution 在 datawise-connectors/pom.xml。
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>${maven-antrun-plugin.version}</version>
                </plugin>

                <!--
                  build-helper-maven-plugin
                  作用：额外注册源码/资源目录（如 ANTLR 生成目录），sqlflow 已在用。
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>build-helper-maven-plugin</artifactId>
                    <version>${build-helper-plugin.version}</version>
                </plugin>

                <!--
                  maven-source-plugin
                  作用：打包 *-sources.jar，方便 IDE 点进源码 / 发布到仓库。
                  用法：子模块绑定 jar-no-fork，或 mvn source:jar
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                </plugin>

                <!--
                  flatten-maven-plugin
                  作用：发布前把 POM 展平（去掉 parent 里的占位符等），生成 .flattened-pom.xml。
                  当前工程若只内部构建可不启用；发布到 Maven 仓库时再绑 execution。
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>${flatten-plugin.version}</version>
                    <configuration>
                        <updatePomFile>true</updatePomFile>
                        <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    </configuration>
                </plugin>

                <!--
                  jacoco-maven-plugin
                  作用：单元测试覆盖率报告（target/site/jacoco）；阈值门禁默认关。
                  报告：随 mvn test 生成；阈值：jacoco:check -Djacoco.check.skip=false
                -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <skip>${jacoco.skip}</skip>
                        <rules>
                            <rule>
                                <element>BUNDLE</element>
                                <limits>
                                    <limit>
                                        <counter>LINE</counter>
                                        <value>COVEREDRATIO</value>
                                        <minimum>${jacoco.line.minimum}</minimum>
                                    </limit>
                                </limits>
                            </rule>
                        </rules>
                    </configuration>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <skip>${jacoco.check.skip}</skip>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>

                <!--
                  spotless-maven-plugin
                  作用：按 Eclipse 规则格式化 Java、统一 LF。
                  默认 skip。格式化：mvn spotless:apply -Dspotless.skip=false
                  仅检查：mvn spotless:check -Dspotless.skip=false
                  说明：licenseHeader / removeUnusedImports 暂不启用——google-java-format
                  removeUnusedImports 对本仓源码解析失败（1:2 class expected）；许可证头改走 mycila。
                -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-plugin.version}</version>
                    <configuration>
                        <skip>${spotless.skip}</skip>
                        <java>
                            <lineEndings>UNIX</lineEndings>
                            <eclipse>
                                <file>${datawise.workspaces}/.tools/format/phenixan_spotless_formatter.xml</file>
                            </eclipse>
                        </java>
                    </configuration>
                </plugin>

                <!--
                  maven-checkstyle-plugin
                  作用：按 .tools/checkstyle 规则做风格门禁（禁止 printStackTrace、星号 import 等）。
                  默认 skip。检查：mvn checkstyle:check -Dcheckstyle.skip=false
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven-checkstyle-plugin.version}</version>
                    <!-- 固定 Checkstyle 运行时，与 phenixan_checkstyle.xml（Checker 下 LineLength）匹配 -->
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>10.12.5</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <skip>${checkstyle.skip}</skip>
                        <configLocation>${datawise.workspaces}/.tools/checkstyle/phenixan_checkstyle.xml</configLocation>
                        <suppressionsLocation>${datawise.workspaces}/.tools/suppressions.xml</suppressionsLocation>
                        <consoleOutput>true</consoleOutput>
                        <failOnViolation>true</failOnViolation>
                        <violationSeverity>warning</violationSeverity>
                        <logViolationsToConsole>true</logViolationsToConsole>
                        <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    </configuration>
                </plugin>

                <!--
                  license-maven-plugin (mycila)
                  作用：批量检查/写入 Java 文件许可证头。
                  默认 skip，且不绑到生命周期（避免每次编译改源码）。
                  检查：mvn license:check -Dlicense.skip=false
                  写入：mvn license:format -Dlicense.skip=false
                -->
                <plugin>
                    <groupId>com.mycila</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>${license-plugin.version}</version>
                    <configuration>
                        <skip>${license.skip}</skip>
                        <licenseSets>
                            <licenseSet>
                                <header>${datawise.workspaces}/.tools/copyright.txt</header>
                                <includes>
                                    <include>**/*.java</include>
                                </includes>
                                <excludes>
                                    <exclude>**/package-info.java</exclude>
                                    <exclude>**/generated-sources/**</exclude>
                                </excludes>
                            </licenseSet>
                        </licenseSets>
                        <mapping>
                            <java>SLASHSTAR_STYLE</java>
                        </mapping>
                        <useDefaultMapping>true</useDefaultMapping>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <!-- 质量类：已声明，默认 skip；见上方中文注释中的命令 -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
