        <pty4j.version>0.13.4</pty4j.version>

        <!-- 自旧 datawise 根 POM 迁入的插件版本 -->
        <maven-shade-plugin.version>3.6.0</maven-shade-plugin.version>
        <maven-dependency-plugin.version>3.6.1</maven-dependency-plugin.version>
        <maven-antrun-plugin.version>3.1.0</maven-antrun-plugin.version>
        <build-helper-plugin.version>3.6.0</build-helper-plugin.version>
        <spotless-plugin.version>2.43.0</spotless-plugin.version>
        <jacoco.version>0.8.12</jacoco.version>
        <maven-checkstyle-plugin.version>3.3.0</maven-checkstyle-plugin.version>
        <flatten-plugin.version>1.6.0</flatten-plugin.version>
        <license-plugin.version>4.2</license-plugin.version>

        <!-- 质量插件默认关闭，避免日常构建被风格问题打断；需要时 -Dxxx.skip=false -->
        <spotless.skip>true</spotless.skip>
        <checkstyle.skip>true</checkstyle.skip>
        <license.skip>true</license.skip>
        <!-- Jacoco 报告默认开启；阈值门禁默认关，CI 对选中模块 -Djacoco.check.skip=false -->
        <jacoco.skip>false</jacoco.skip>
        <jacoco.check.skip>true</jacoco.check.skip>
        <!--
          行覆盖率下限。实测（2026-11）：common 33.5% / config 57.6% / connector-api 46.5%
          / connector-spi 28.9%。取 25% 作为所有模块都能守住的下限，避免门禁因空转而失去意义；
          后续逐模块抬升，不要一次性拉到目标值。
        -->
        <jacoco.line.minimum>0.25</jacoco.line.minimum>
        <!--
          surefire / failsafe 用 @{argLine} 接住 jacoco 注入的 -javaagent。
          这里给一个空默认值：未经 prepare-agent（例如 IDE 或直接调用单测 goal）时
          late replacement 仍能解析，不会把字面量 @{argLine} 传给 JVM。
        -->
        <argLine></argLine>
    </properties>

