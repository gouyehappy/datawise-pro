        <!-- Multi-module reactor root (Maven 3.3.1+); used by quality plugins under .tools/ -->
        <datawise.workspaces>${maven.multiModuleProjectDirectory}</datawise.workspaces>
        <!-- Reproducible builds (C5): override with -Dproject.build.outputTimestamp=… or SOURCE_DATE_EPOCH -->
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>

        <jsqlparser.version>5.3</jsqlparser.version>
        <spring-ai.version>1.0.0</spring-ai.version>
