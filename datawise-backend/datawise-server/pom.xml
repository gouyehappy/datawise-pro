<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.datawise</groupId>
        <artifactId>datawise-backend</artifactId>
        <version>5.0.0</version>
    </parent>

    <artifactId>datawise-server</artifactId>
    <name>datawise-server</name>
    <description>Spring Boot HTTP entrypoint and REST controllers</description>

    <dependencies>
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-database</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-sync</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-backup</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-taskconcurrency</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-workspace</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <!-- Optional module: present by default for full builds; -Pwithout-ai strips from fat jar.
                 Server main sources must not import org.apache.datawise.backend.ai.* (ArchUnit + ci-scan). -->
            <artifactId>datawise-ai</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-lineage</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-metadoc</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-datagen</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- 数据源引擎；具体 connector 插件由 config/plugins/*.jar 提供 -->
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-connector-api</artifactId>
        </dependency>
        <!-- 测试仍可用 classpath 插件（与 config/plugins 二选一/可并存，同 id 时目录插件优先） -->
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-connector-all</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- SSH connector runtime (shell sessions + plugin registration) -->
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-connector-ssh</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.datawise</groupId>
            <artifactId>datawise-connector-kubernetes</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>org.apache.datawise.backend.DatawiseBackendApplication</mainClass>
                    <!-- Always strip JMH; pack profiles append module excludes (combine.children). -->
                    <excludes>
                        <exclude>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-core</artifactId>
                        </exclude>
                        <exclude>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      ops-extras: Prometheus + Swagger UI for web/dev (active when NOT packaging desktop).
      desktop packaging: -Ddatawise.desktop.packaging=true activates profile "desktop"
      and skips ops-extras (!datawise.desktop.packaging), so fat-jar omits Swagger UI / Prometheus.
    -->
    <profiles>
        <profile>
            <id>ops-extras</id>
            <activation>
                <property>
                    <name>!datawise.desktop.packaging</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.micrometer</groupId>
                    <artifactId>micrometer-registry-prometheus</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.springdoc</groupId>
                    <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                    <version>2.6.0</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>without-ai</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <skip>false</skip>
                            <mainClass>org.apache.datawise.backend.DatawiseBackendApplication</mainClass>
                            <excludes combine.children="append">
                                <exclude>
                                    <groupId>org.apache.datawise</groupId>
                                    <artifactId>datawise-ai</artifactId>
                                </exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>without-lineage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <skip>false</skip>
                            <mainClass>org.apache.datawise.backend.DatawiseBackendApplication</mainClass>
                            <excludes combine.children="append">
                                <exclude>
                                    <groupId>org.apache.datawise</groupId>
                                    <artifactId>datawise-lineage</artifactId>
                                </exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>without-metadoc</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <skip>false</skip>
                            <mainClass>org.apache.datawise.backend.DatawiseBackendApplication</mainClass>
                            <excludes combine.children="append">
                                <exclude>
                                    <groupId>org.apache.datawise</groupId>
                                    <artifactId>datawise-metadoc</artifactId>
                                </exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>without-datagen</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <skip>false</skip>
                            <mainClass>org.apache.datawise.backend.DatawiseBackendApplication</mainClass>
                            <excludes combine.children="append">
                                <exclude>
                                    <groupId>org.apache.datawise</groupId>
                                    <artifactId>datawise-datagen</artifactId>
                                </exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>without-sync</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <skip>false</skip>
                            <mainClass>org.apache.datawise.backend.DatawiseBackendApplication</mainClass>
                            <excludes combine.children="append">
                                <exclude>
                                    <groupId>org.apache.datawise</groupId>
                                    <artifactId>datawise-sync</artifactId>
                                </exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>without-backup</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <skip>false</skip>
                            <mainClass>org.apache.datawise.backend.DatawiseBackendApplication</mainClass>
                            <excludes combine.children="append">
                                <exclude>
                                    <groupId>org.apache.datawise</groupId>
                                    <artifactId>datawise-backup</artifactId>
                                </exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- Standard Core marker (§2.2). Package with:
             -Pstandard,ops-extras -Dspring-boot.excludes=...:datawise-backup
             (see scripts/pack/without-ai-jar-scan.sh). Individual -Pwithout-* still available. -->
        <profile>
            <id>standard</id>
            <properties>
                <datawise.pack.edition>standard</datawise.pack.edition>
            </properties>
        </profile>
        <profile>
            <id>desktop</id>
            <activation>
                <property>
                    <name>datawise.desktop.packaging</name>
                    <value>true</value>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.apache.datawise</groupId>
                    <artifactId>datawise-desktop</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <!-- No springdoc on desktop: OpenAPI UI/docs disabled in application-desktop.yml -->
            </dependencies>
            <build>
                <plugins>
                    <!-- ops-extras (springdoc) is off; exclude OpenAPI bean source so compile succeeds -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/OpenApiConfiguration.java</exclude>
                            </excludes>
                            <testExcludes>
                                <exclude>**/OpenApiConfiguration*.java</exclude>
                            </testExcludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <skip>false</skip>
                            <mainClass>org.apache.datawise.backend.DatawiseBackendApplication</mainClass>
                            <excludes>
                                <exclude>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-core</artifactId>
                                </exclude>
                                <exclude>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                </exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
