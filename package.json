{
  "name": "datawise-monorepo",
  "version": "5.0.0",
  "private": true,
  "description": "DataWise monorepo — 常用命令入口（详见 npm run help）",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "help": "node scripts/dw.mjs help",
    "clean": "node scripts/dw.mjs clean",
    "frontend": "node scripts/dw.mjs frontend",
    "frontend:standard": "node scripts/dw.mjs frontend:standard",
    "backend": "node scripts/dw.mjs backend",
    "backend:standard": "node scripts/dw.mjs backend:standard",
    "plugins": "node scripts/dw.mjs plugins",
    "all": "node scripts/dw.mjs all",
    "dist": "node scripts/dw.mjs dist",
    "dist:slim": "node scripts/dw.mjs dist:slim",
    "dist:full": "node scripts/dw.mjs dist:full",
    "dist:publish": "node scripts/dw.mjs dist:publish",
    "mock:connector-market": "node datawise-frontend/scripts/desktop/mock-connector-market.mjs",
    "mock:connector-market:seed": "node datawise-frontend/scripts/desktop/mock-connector-market.mjs --no-serve --seed-user",
    "mock:connector-market:build": "node datawise-frontend/scripts/desktop/mock-connector-market.mjs --build --no-serve --seed-user",
    "dev": "node scripts/dw.mjs dev",
    "dev:standard": "node scripts/dw.mjs dev:standard",
    "website": "npm run dev --prefix website",
    "website:build": "npm run build --prefix website",
    "stop": "node scripts/dw.mjs stop",
    "smoke:community-plugin": "node scripts/dw.mjs smoke:community-plugin",
    "plugin": "node scripts/datawise-plugin.mjs",
    "plugin:package": "node scripts/datawise-plugin.mjs package",
    "plugin:keygen": "node scripts/datawise-plugin.mjs keygen",
    "plugin:rebuild-hello-fixture": "node scripts/rebuild-hello-community-fixture.mjs",
    "export:openapi": "node scripts/export-openapi.mjs",
    "gen:openapi-types": "npx --yes openapi-typescript docs/openapi/openapi.json -o datawise-frontend/src/shared/api/generated/openapi.d.ts",
    "typecheck:sql-editor": "npm run typecheck --prefix sql-editor",
    "test:sql-editor": "npm run test --prefix sql-editor",
    "build:sql-editor": "npm run build:lib --prefix sql-editor",
    "typecheck:frontend": "npm run typecheck --prefix datawise-frontend",
    "typecheck": "npm run typecheck:sql-editor && npm run typecheck:frontend",
    "typecheck:packages": "npm run typecheck --workspaces --if-present",
    "audit:packages-boundary": "node scripts/audit-packages-boundary.mjs",
    "ensure:sql-editor": "npm run ensure:sql-editor --prefix datawise-frontend",
    "dev:frontend": "npm run dev --prefix datawise-frontend"
  }
}
